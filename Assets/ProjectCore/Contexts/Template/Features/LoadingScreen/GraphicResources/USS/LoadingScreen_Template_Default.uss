.default-loading-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(7, 14, 26);
}

.default-loading-screen__panel {
    width: 28%;
    align-items: center;
    padding-left: 3%;
    padding-right: 3%;
    padding-top: 3%;
    padding-bottom: 3%;
    background-color: rgba(17, 31, 52, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.default-loading-screen__title {
    margin-bottom: 8%;
    color: rgb(255, 216, 104);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.default-loading-screen__progress-track {
    width: 100%;
    height: 12px;
    margin-bottom: 7%;
    background-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.default-loading-screen__progress-value {
    width: 64%;
    height: 100%;
    background-color: rgb(255, 216, 104);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.default-loading-screen__message {
    color: rgb(221, 231, 244);
    font-size: 18px;
    -unity-text-align: middle-center;
}
