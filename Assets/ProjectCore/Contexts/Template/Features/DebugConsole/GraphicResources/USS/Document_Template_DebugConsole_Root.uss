.console-root {
    flex-grow: 1;
}

.console-window {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 8px;
    height: 70%;
    background-color: rgba(20, 20, 20, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(56, 56, 56);
    border-right-color: rgb(56, 56, 56);
    border-bottom-color: rgb(56, 56, 56);
    border-left-color: rgb(56, 56, 56);
    flex-direction: column;
}

.console-main-resize-handle {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 14px;
    height: 14px;
    background-color: rgba(120, 120, 120, 0.6);
}

.console-header {
    flex-direction: row;
    height: 34px;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 50, 50);
}

.console-tab-button {
    margin-right: 6px;
    height: 24px;
    color: white;
}

.console-tab-button-active { background-color: rgb(51, 89, 140); }
.console-tab-button-inactive { background-color: rgb(51, 51, 51); }

.console-root .unity-button {
    color: white;
    background-color: rgb(51, 51, 51);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(80, 80, 80);
    border-right-color: rgb(80, 80, 80);
    border-bottom-color: rgb(80, 80, 80);
    border-left-color: rgb(80, 80, 80);
}

.console-status-label {
    font-size: 11px;
    color: rgb(204, 204, 204);
    margin-right: 10px;
}

.console-version-label {
    font-size: 11px;
    color: aliceblue;
}

.console-close-button {
    margin-left: 8px;
}

.console-launcher-button {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 88px;
    height: 28px;
}

.console-content {
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.console-tab {
    flex-grow: 1;
    flex-direction: column;
}

.console-log-toolbar {
    flex-direction: row;
    align-items: flex-start;
    height: 35px;
    margin-bottom: 6px;
}

.console-filter-toggle > .unity-toggle__label {
    margin-right: 8px;
    color: aliceblue;
}

.console-log-filter {
    height: 100%;
    width: 600px;
    margin-left: 8px;
    color: aliceblue;
}

.console-log-filter > .unity-text-field__label{
    color: aliceblue;
}

.console-log-filter > .unity-text-field__input{
    color: black;
    -unity-font-style: bold;
    font-size: 100%;
}

.console-button{
    margin-left: 8px;
}

.console-logs-scroll {
    flex-grow: 1;
    background-color: rgba(13, 13, 13, 0.9);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(50, 50, 50);
    border-right-color: rgb(50, 50, 50);
    border-bottom-color: rgb(50, 50, 50);
    border-left-color: rgb(50, 50, 50);
}

.console-log-line {
    unity-text-align: upper-left;
}

.console-log-entry {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.console-log-entry-selected {
    background-color: rgba(80, 120, 170, 0.35);
}

.console-log-details-scroll {
    min-height: 72px;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: rgba(18, 18, 18, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(50, 50, 50);
    border-right-color: rgb(50, 50, 50);
    border-bottom-color: rgb(50, 50, 50);
    border-left-color: rgb(50, 50, 50);
}

.console-details-resize-handle {
    height: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: rgba(120, 120, 120, 0.5);
}

.console-log-details {
    padding: 6px;
    white-space: normal;
    color: aliceblue;
}

.console-autocomplete {
    flex-direction: column;
    margin-bottom: 6px;
}

.console-autocomplete-item {
    margin-bottom: 2px;
    padding-left: 10px;
    align-self: flex-start;
    color: black;
    -unity-font-style: bold;
}

.console-input-row {
    height: 35px;
    margin-top: 6px;
    flex-direction: row;
}

.console-command-input {
    height: 100%;
    flex-grow: 1;
}

.console-command-input > .unity-text-field__input{
    color: black;
    -unity-font-style: bold;
    font-size: 100%;
}

.console-run-button {
    width: 70px;
    margin-left: 6px;
}

.console-cheat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 50, 50);
}

.console-cheat-group-title {
    margin-top: 10px;
    margin-bottom: 6px;
    color: aliceblue;
    -unity-font-style: bold;
}

.console-cheat-title {
    color: aliceblue;
    width: 220px;
}

.console-cheat-arg {
    color: aliceblue;
    width: 240px;
    margin-right: 6px;
}

.console-cheat-arg > .unity-text-field__label{
    color: aliceblue;
}

.console-dviz-root {
    flex-direction: column;
    flex-grow: 1;
}

.console-dviz-breadcrumbs {
    flex-direction: row;
    height: 28px;
    align-items: center;
    margin-bottom: 6px;
}

.console-dviz-body {
    flex-direction: row;
    flex-grow: 1;
}

.console-dviz-channels {
    flex-basis: 300px;
    margin-right: 6px;
}

.console-dviz-values {
    color: aliceblue;
    flex-grow: 1;
}

.debugviz-value-group-label{
    color: aliceblue;
}

.debugviz-value-group-item-label{
    color: aliceblue;
}

.console-dviz-channel-row {
    flex-direction: row;
    margin-bottom: 2px;
}
