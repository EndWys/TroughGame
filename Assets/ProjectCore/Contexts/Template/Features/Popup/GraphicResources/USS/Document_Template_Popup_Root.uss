.popup__host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.popup__input-blocker,
.popup__interaction-blocker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.popup__input-blocker,
.popup__interaction-blocker {
    background-color: rgba(0, 0, 0, 0);
}

.popup__view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.popup__backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 0.68);
}

.popup__content-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
