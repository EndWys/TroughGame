.prototype-game-hud {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding-left: 3%;
    padding-right: 3%;
    padding-top: 2%;
    padding-bottom: 2%;
}

.prototype-game-hud__header {
    width: 100%;
    align-items: center;
}

.prototype-game-hud__title {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
}

.prototype-game-hud__footer {
    width: 100%;
    align-items: flex-end;
}

.prototype-game-hud__controls {
    width: 24%;
    padding-left: 2%;
    padding-right: 2%;
    padding-top: 2%;
    padding-bottom: 2%;
    background-color: rgba(8, 18, 34, 0.78);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.prototype-game-hud__controls-title {
    margin-bottom: 8%;
    color: rgb(255, 216, 104);
    font-size: 20px;
    -unity-font-style: bold;
}

.prototype-game-hud__control {
    margin-bottom: 4%;
    color: rgb(235, 244, 255);
    font-size: 18px;
}
